<div class="card card-md bg-base-300">
  <img
    src="<%= mealKit.imageUrl %>"
    alt="<%= mealKit.title %>"
    class="rounded-lg w-full h-48 object-cover"
  />

  <div class="card-body">
    <h3 class="card-title text-lg"><%= mealKit.title %></h3>
    <p class="text-sm text-gray-200"><%= mealKit.includes %></p>
    <p class="text-sm"><%= mealKit.description %></p>
    <!--display in row-->
    <div class="flex justify-between items-center mt-4">
      <div class="text-lg font-bold text-primary">$<%= mealKit.price %></div>
      <p class="ml-2 text-gray-600"><%= mealKit.cookingTime %> min</p>
    </div>
    <p class="text-gray-600"><%= mealKit.servings %> servings</p>

    <!-- check role buttons -->
    <% if (user) { %>
      <% if (user.role === 'customer') { %>
        <form method="POST" action="/cart/add/<%= mealKit._id %>" class="mt-4">
          <button type="submit" class="btn btn-primary w-full">Buy</button>
        </form>
      <% } else if (user.role === 'clerk') { %>
        <div class="flex gap-2 mt-4">
          <a href="/mealkits/edit/<%= mealKit._id %>" class="btn btn-primary flex-1">Edit</a>

        <form action="/mealkits/delete/<%= mealKit._id %>" method="POST" onsubmit="return confirmDelete()" class="flex-1">
          <button type="submit" class="btn btn-error w-full">Delete</button>
        </form>
      </div>
      <% } %>
    <% } %>
  </div>
</div>
<script>
function confirmDelete() {
    return confirm("Are you sure you want to delete this MealKit?");
}
</script>