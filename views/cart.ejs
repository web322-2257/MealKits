<div class="container mx-auto p-8">
    <h1 class="text-4xl font-bold mb-8">Shopping Cart</h1>

    <!-- Success/Error Messages -->
    <% if (message) { %>
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
            <%= message %>
        </div>
    <% } %>

    <% if (errors.general) { %>
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
            <%= errors.general %>
        </div>
    <% } %>

    <% if (cart.length === 0) { %>
        <!-- Empty Cart -->
        <div class="text-center py-16">
            <h2 class="text-2xl mb-4">Your cart is empty</h2>
            <a href="/mealkits" class="btn btn-primary">Browse Meal Kits</a>
        </div>
    <% } else { %>
        <!-- Cart Table -->
        <div class="overflow-x-auto mb-8">
            <table class="table w-full bg-base-200">
                <thead>
                    <tr>
                        <th>Image</th>
                        <th>Meal Kit</th>
                        <th>Price</th>
                        <th>Quantity</th>
                        <th>Total</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% cart.forEach(item => { %>
                        <tr>
                            <!-- Image -->
                            <td>
                                <img src="<%= item.mealkit.imageUrl %>" 
                                     alt="<%= item.mealkit.title %>" 
                                     class="w-20 h-20 object-cover rounded">
                            </td>
                            
                            <!-- Title & Includes -->
                            <td>
                                <div class="font-bold"><%= item.mealkit.title %></div>
                                <div class="text-sm text-gray-500"><%= item.mealkit.includes %></div>
                            </td>
                            
                            <!-- Price -->
                            <td>$<%= item.mealkit.price.toFixed(2) %></td>
                            
                            <!-- Quantity -->
                            <td>
                                <form method="POST" action="/cart/add/<%= item.id %>" class="flex items-center gap-2">
                                    <input type="number" 
                                           name="quantity" 
                                           value="<%= item.qty %>" 
                                           min="1" 
                                           class="input input-bordered input-sm w-20">
                                    <button type="submit" class="btn btn-sm btn-primary">Update</button>
                                </form>
                            </td>
                            
                            <!-- Line Total -->
                            <td class="font-bold">$<%= (item.mealkit.price * item.qty).toFixed(2) %></td>
                            
                            <!-- Remove -->
                            <td>
                                <form method="POST" action="/cart/remove/<%= item.id %>">
                                    <button type="submit" class="btn btn-sm btn-error">Remove</button>
                                </form>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>

        <!-- Totals -->
        <div class="flex justify-end">
            <div class="w-full md:w-1/3 space-y-2">
                <div class="flex justify-between text-lg">
                    <span>Subtotal:</span>
                    <span>$<%= subtotal.toFixed(2) %></span>
                </div>
                <div class="flex justify-between text-lg">
                    <span>Tax (10%):</span>
                    <span>$<%= tax.toFixed(2) %></span>
                </div>
                <div class="divider my-2"></div>
                <div class="flex justify-between text-2xl font-bold">
                    <span>Grand Total:</span>
                    <span class="text-primary">$<%= grandTotal.toFixed(2) %></span>
                </div>

                <!-- Place Order Button -->
                <form method="POST" action="/cart/checkout" class="mt-6">
                    <button type="submit" class="btn btn-primary btn-lg w-full">
                        Place Order
                    </button>
                </form>
            </div>
        </div>
    <% } %>
</div>