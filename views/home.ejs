<!--Hero section, display text ontop of image-->
<div class="relative h-96 flex items-center justify-center">
  <img
    src="/imgs/hero.png"
    alt="Hero"
    class="absolute inset-0 w-full h-full object-cover opacity-60"
  />
  <div class="relative text-center text-white px-4">
    <h1 class="text-4xl font-bold mb-4">Welcome to Meal Planner!</h1>
    <p class="text-lg max-w-2xl">
      Get fresh ingredients, easy to cook, prepare and change to your liking, delivered free, to
      your doorstep.
    </p>
  </div>
</div>

<!--Main header in grid format-->
<div class="py-16">
  <h2 class="text-3xl font-bold text-center mb-12">How it works</h2>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 max-w-6xl mx-auto px-4">

<!--For each content display img in circle and information-->
  <div class="card card-md bg-primary">
  <img src="/imgs/h1.jpg"  class="w-32 h-32 mb-2 rounded-full mx-auto object-cover border-2 mt-4">
  <div class="card-body text-center">
    <h3 class="card-title text-white ml-10 mt-2">What We Do</h3>
    <p class="text-sm text-white">
      We provide fresh, ready-to-cook meal kits delivered straight to your door so you can enjoy healthy meals without the hassle.
    </p>
  </div>
</div>

<div class="card card-md bg-primary">
  <img src="/imgs/h2.jpg" class="w-32 h-32 mb-2 rounded-full mx-auto object-cover border-4 border-white mt-4">
    <div class="card-body text-center">
      <h3 class="card-title text-white ml-10 mt-2"> Our Mission</h3>
      <p class="text-sm text-white">
      Our mission is to aid you in being healthy, providing nutritious, but delicious foods is the goal that fuels us.
    </p>
  </div>
</div>

<div class="card card-md bg-primary">
  <img src="/imgs/h3.jpg" alt="What We Do" class="w-32 h-32 mb-2 rounded-full mx-auto object-cover border-4 border-white mt-4">
    <div class="card-body text-center">
      <h3 class="card-title text-white ml-3  mt-2">How does it work?</h3>
      <p class="text-sm text-white">
      We simply cook the meals, sourcing the finest, nutritious ingredients, our chefs prepare the meals, ready to eat at any time.
  </div>
</div>

<div class="card card-md bg-primary">
  <img src="/imgs/h4.jpg" alt="What We Do" class="w-32 h-32 mb-2  rounded-full mx-auto object-cover border-4 border-white mt-4">
    <div class="card-body text-center">
      <h3 class="card-title text-white ml-10 pl-7 mt-2">Why?</h3>
      <p class="text-sm text-white">
      Whether you're on a diet, tracking your food, or overall want nutritious meals, we can fulfill that goal. Everyone deserves to eat, and live good.
    </p>
  </div>
</div>
</div>

<div class="py-16">
  <h2 class="text-3xl font-bold text-center mb-12">Meals</h2>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 max-w-6xl mx-auto px-4">
      <% featuredMealKits.forEach(meal => { %>
      <%- include('partials/mealkit', {mealKit : meal}) %>
    <% }) %>
  </div>
</div>
