<div class="max-w-2xl mx-auto mt-5">
    <h1 class="text-5xl font-bold text-center text-white mb-6">Edit Meal Kit</h1>

    <form method="POST" action="/mealkits/edit/<%= mealkit._id %>" enctype="multipart/form-data" class="space-y-4">
        
        <!-- meal kit will be passed in here to edit -->
        <div>
            <label class="label">
                Title
            </label>
            <input 
                type="text" 
                name="title" 
                value="<%= mealkit.title %>"
                class="input input-bordered w-full" 
                placeholder="e.g., Creamy Tuscan Chicken"
            />
            <% if (errors.title) { %>
                <p class="text-red-600 text-sm mt-1"><%= errors.title %></p>
            <% } %>
        </div>

        <!-- Includes -->
        <div>
            <label class="label">
                Includes
            </label>
            <input 
                type="text" 
                name="includes" 
                value="<%= mealkit.includes %>"
                class="input input-bordered w-full" 
                placeholder="e.g., Chicken breast, sun-dried tomatoes, spinach"
            />
            <% if (errors.includes) { %>
                <p class="text-red-600 text-sm mt-1"><%= errors.includes %></p>
            <% } %>
        </div>

        <!-- Description -->
        <div>
            <label class="label">
                <span class="label-text">Description *</span>
            </label>
            <textarea 
                name="description" 
                rows="4"
                class="textarea textarea-bordered w-full" 
                placeholder="Describe the meal kit..."
            ><%= mealkit.description %></textarea>
            <% if (errors.description) { %>
                <p class="text-red-600 text-sm mt-1"><%= errors.description %></p>
            <% } %>
        </div>

        <!-- Category -->
        <div>
            <label class="label">
                <span class="label-text">Category *</span>
            </label>
            <input 
                type="text" 
                name="category" 
                value="<%= mealkit.category %>"
                class="input input-bordered w-full" 
                placeholder="e.g., Italian, Asian, Mexican"
            />
            <% if (errors.category) { %>
                <p class="text-red-600 text-sm mt-1"><%= errors.category %></p>
            <% } %>
        </div>

        <!-- Price -->
        <div>
            <label class="label">
                <span class="label-text">Price *</span>
            </label>
            <input 
                type="number" 
                name="price" 
                value="<%= mealkit.price %>"
                step="0.01"
                min="0.01"
                class="input input-bordered w-full" 
                placeholder="24.99"
            />
            <% if (errors.price) { %>
                <p class="text-red-600 text-sm mt-1"><%= errors.price %></p>
            <% } %>
        </div>

        <!-- Cooking Time -->
        <div>
            <label class="label">
                <span class="label-text">Cooking Time (minutes) *</span>
            </label>
            <input 
                type="number" 
                name="cookingTime" 
                value="<%= mealkit.cookingTime %>"
                min="1"
                class="input input-bordered w-full" 
                placeholder="30"
            />
            <% if (errors.cookingTime) { %>
                <p class="text-red-600 text-sm mt-1"><%= errors.cookingTime %></p>
            <% } %>
        </div>

        <!-- Servings -->
        <div>
            <label class="label">
                <span class="label-text">Servings *</span>
            </label>
            <input 
                type="number" 
                name="servings" 
                value="<%= mealkit.servings %>"
                min="1"
                class="input input-bordered w-full" 
                placeholder="2"
            />
            <% if (errors.servings) { %>
                <p class="text-red-600 text-sm mt-1"><%= errors.servings %></p>
            <% } %>
        </div>

        <!-- Current Image Display -->
        <div>
            <label class="label">
                <span class="label-text">Current Image</span>
            </label>
            <img src="<%= mealkit.imageUrl %>" alt="<%= mealkit.title %>" class="w-48 h-48 object-cover rounded-lg mb-2">
        </div>

        <!-- Image Upload (Optional) -->
        <div>
            <label class="label">
                <span class="label-text">Upload New Image (optional)</span>
            </label>
            <input 
                type="file" 
                name="image" 
                accept="image/jpeg,image/jpg,image/png,image/gif"
                class="file-input file-input-bordered w-full" 
            />
            <p class="text-sm text-gray-500 mt-1">Leave empty to keep current image</p>
            <% if (errors.image) { %>
                <p class="text-red-600 text-sm mt-1"><%= errors.image %></p>
            <% } %>
        </div>

        <!-- Featured Meal Kit -->
        <label class="label cursor-pointer justify-start gap-4">
            <input 
                type="checkbox" 
                name="featuredMealKit" 
                class="checkbox" 
                <%= mealkit.featuredMealKit ? 'checked' : '' %>
            />
            <span class="label-text">Featured Meal Kit</span>
        </label>

        <!-- General Error -->
        <% if (errors.general) { %>
            <div class="alert alert-error">
                <%= errors.general %>
            </div>
        <% } %>

        <!-- Buttons -->
        <button type="submit" class="btn btn-md btn-primary">Update Meal Kit</button>
        <a href="/mealkits/list" class="btn btn-md btn-error">Cancel</a>
    </form>
</div>