<div class="container mx-auto p-8">
  <div class="flex items-center gap-6 mb-10">
  <h1 class="text-5xl font-bold text-white">Meal Kits List</h1>
  <a href="/mealkits/add" class="btn btn-md btn-secondary btn-sm text-white">Add Meal</a>
</div>


  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    <% mealKits.forEach(mealKit => { %>
      <%- include('partials/mealkit', { mealKit: mealKit }) %>
    <% }); %>
  </div>
</div>