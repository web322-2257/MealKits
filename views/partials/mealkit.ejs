<div class="card bg-base-100 shadow-xl">
  <img
    src="<%= mealKit.imageUrl %>"
    alt="<%= mealKit.title %>"
    class="rounded-xl w-full h-48 object-cover"
  />

  <div class="card-body">
    <h3 class="card-title text-lg"><%= mealKit.title %></h3>
    <p class="text-sm text-gray-600"><%= mealKit.includes %></p>
    <p class="text-sm"><%= mealKit.description %></p>
    <div class="flex justify-between items-center mt-4">
      <div class="text-lg font-bold text-primary">$<%= mealKit.price.toFixed(2) %></div>
      <p class="text-gray-600"><%= mealKit.cookingTime %> min</p>
    </div>
    <p class="text-gray-600"><%= mealKit.servings %> servings</p>
  </div>
</div>
